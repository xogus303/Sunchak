# 이 파일은 "필요한 키 목록·형식" 참고용이다. 실제 비밀값은 Infisical에 저장하고
# `infisical run -- <명령>`으로 주입한다 (ADR 0011). 로컬 .env로 직접 실행도 가능.

# 서버 포트 (프론트 Next.js가 3000을 쓰므로 3001)
PORT=3001

# 프론트(apps/web) 주소 — CORS 허용 origin + Google 로그인 완료 후 리다이렉트 대상
WEB_APP_URL="http://localhost:3000"

# PostgreSQL 접속 정보 (비밀값 — 실제 값은 git에 올리지 말 것)
# [개발·공유] Neon 클라우드 DB — 두 기기가 같은 URL로 접속해 데이터 공유 (ADR 0010)
#   Neon 대시보드에서 발급한 문자열을 각 기기의 .env 에 붙여넣는다.
#   형식 예: postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/sunchak?sslmode=require
# [W2 부하테스트] 로컬 Postgres — infra/docker-compose.yml 계정과 일치
#   postgresql://sunchak:sunchak@localhost:5432/sunchak?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST/sunchak?sslmode=require"

# 마이그레이션(prisma migrate deploy) 전용 direct 연결. Neon의 pooled 연결(pgbouncer)은
# 스키마 락 동작과 안 맞아 Neon 공식 가이드가 마이그레이션엔 direct 연결을 쓰라고
# 명시한다(2026-08-21 확인). 로컬 Postgres는 풀러가 없어 DATABASE_URL과 같은 값이면 된다.
# Neon 콘솔의 "Connect" 모달에서 Connection pooling 토글을 끄면 direct 연결 문자열을 얻는다.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/sunchak?sslmode=require"

# Redis 연결 (로컬 — docker-compose)
REDIS_URL="redis://localhost:6379"

# JWT (W1 인증 단계에서 사용)
JWT_SECRET="change-me-in-local"
JWT_EXPIRES_IN="1h"

# Google SSO 로그인 (W4) — Google Cloud Console에서 OAuth 클라이언트 발급
# (비밀값 — 실제 값은 Infisical). 미설정 시 앱은 정상 기동하되 /auth/google
# 시도 시 Google이 invalid_client로 거부한다(JWT_SECRET처럼 부팅을 막지 않음).
GOOGLE_CLIENT_ID="change-me-in-local"
GOOGLE_CLIENT_SECRET="change-me-in-local"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# 공개 데모 모드 (W4에서 사용 · ADR 0016) — 무료 티어 위 공개 배포 하드닝
# 진입 게이트 공유 비번 (비밀값 — 실제 값은 Infisical. 포트폴리오엔 공개하는 값)
DEMO_GATE_PASSWORD="change-me-in-local"
# 부하 시뮬레이션 1회 최대 가상 유저 수 (한도 보호)
DEMO_SIM_MAX_VU="300"
# 시뮬레이션 재실행 쿨다운 (ms) — 수동 "가상 유저 투입" 버튼용
DEMO_SIM_COOLDOWN_MS="30000"
# 이벤트 상세 페이지 마운트 시 자동 투입 전용 쿨다운 (ms) — 위보다 훨씬 짧게 둬서
# 방문자가 뒤로 가기 후 재입장해도 매번 새 크라우드가 들어가게 한다(2026-08-07)
DEMO_SIM_AUTO_COOLDOWN_MS="3000"
# 데모 데이터 자동 리셋 주기 (ms)
DEMO_RESET_INTERVAL_MS="600000"

# 선착순 입장 대기열 (ADR 0017)
# 입장 허가창 — 대기열에서 순서가 온 뒤 이 시간(ms) 안에 예매를 시도해야 한다.
QUEUE_ADMISSION_WINDOW_MS="8000"
# 가상 유저 현실성 — 입장 허가를 받아도 포기할 확률(0~1)
DEMO_SIM_ABANDON_PROBABILITY="0.08"
# 가상 유저가 입장 허가 후 예매를 시도하기까지의 랜덤 지연 범위(ms)
# — 위 허가창(8초)보다 살짝 넓게 잡아야 "대부분 성공, 느린 일부만 놓침"이 된다.
DEMO_SIM_MIN_BOOKING_DELAY_MS="500"
DEMO_SIM_MAX_BOOKING_DELAY_MS="10000"

# 대용량 트래픽 테스트 (ADR 0016 백로그) — 캐주얼 데모와 완전히 별도 경로.
# 재실행 쿨다운 (ms) — 실질적인 Neon 부담 상한선은 이 값이 아니라 예매 시도
# 페이스(다음 단계에서 추가될 LOAD_TEST_SIM_BATCH_* 상수)가 맡는다.
LOAD_TEST_COOLDOWN_MS="60000"
# 1회 최대 가상 유저 수
LOAD_TEST_MAX_VU="10000"
# 재고 상한 — VU 상한과 같은 값으로 통일(2026-08-25)
LOAD_TEST_MAX_STOCK="10000"
# 입장 허가(체감용, 변동 배치) — 남은 대기 인원의 이 비율을 평균(λ)으로 삼아
# 포아송을 정규분포로 근사한 값을 뽑는다(queue/poisson-batch.ts).
LOAD_TEST_ADMISSION_INTERVAL_MS="1000"
LOAD_TEST_ADMISSION_MEAN_FRACTION="0.2"
LOAD_TEST_ADMISSION_MIN_BATCH="50"
LOAD_TEST_ADMISSION_MAX_BATCH="1000"
# 입장 허가 후 예매를 시도할 수 있는 시간 — 캐주얼(QUEUE_ADMISSION_WINDOW_MS,
# 8초)과 공유하던 걸 분리(2026-08-26, 8초는 가상 유저 반응 속도 기준이라
# 실제 사람이 대시보드를 읽고 누르기엔 촉박했다).
LOAD_TEST_ADMISSION_WINDOW_MS="30000"
# 실제 예매 시도 페이스(Postgres INSERT 실질 상한선) — 입장 허가가 아무리
# 커도 이 페이스로 항상 제한된다. 기본 100명/500ms = 초당 200명.
LOAD_TEST_SIM_BATCH_SIZE="100"
LOAD_TEST_SIM_BATCH_INTERVAL_MS="500"
# 결제→확정 파이프라인의 실측 처리량(건/초, 2026-09-01, ADR 0023) — 입장
# 허가가 이 값 × LOAD_TEST_PAYMENT_BURST_WINDOW_MS를 넘는 인원을 동시에
# "결제 처리 중" 상태로 두지 않게 스스로 속도를 늦춘다(백프레셔). 커넥션
# 풀·워커 concurrency를 바꾸면 이 값도 다시 실측해야 한다.
LOAD_TEST_PAYMENT_THROUGHPUT_PER_SEC="60"
# 백프레셔가 "동시에 결제 처리 중이어도 되는 인원"을 계산할 때 쓰는 윈도우
# (2026-09-05, ADR 0018 철회 이력) — LOAD_TEST_ADMISSION_WINDOW_MS(사람이
# 반응할 시간, 30초)와는 별개의 값이지만, "결제 job 처리 시간"만이 아니라
# "HELD 진입→최종 확정/취소까지 걸리는 전체 체류 시간"(사람이 결제 버튼을
# 누르기까지의 랜덤 지연 포함)이어야 한다 — 이 값(2026-09-08 개정)은 배포
# 사이트 실측(HELD 체류 시간 p90=14.9초)을 반올림한 값이다. 너무 작으면
# 아직 결제 시도도 안 한 사람들이 예산을 다 차지해 입장 자체가 불필요하게
# 멈추고(실제 겪은 문제), 너무 크면 순간적으로 몰릴 수 있는 최대 결제 시도
# 인원이 커져 결제 큐가 다시 밀린다 — 인프라를 바꾸면 이 값도 다시 실측해야 한다.
LOAD_TEST_PAYMENT_BURST_WINDOW_MS="15000"
